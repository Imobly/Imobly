# ============================================
# Frontend - HML (Staging) Environment
# ============================================
# Public URLs exposed to the browser (use your deployed domains)
NEXT_PUBLIC_API_URL=https://hml-your-backend.onrender.com/api/v1
NEXT_PUBLIC_AUTH_API_URL=https://hml-your-auth-api.onrender.com/api/v1/auth
NEXT_PUBLIC_APP_URL=https://hml-your-frontend.onrender.com

# Build/runtime
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
