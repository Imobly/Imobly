# ============================================
# Imobly Frontend - Environment Variables
# ============================================

# ====================
# DEVELOPMENT (Local)
# ====================
# Copie para .env.local e use APIs locais
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8001/api/v1/auth
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional: Supabase público
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Informações
NEXT_PUBLIC_APP_NAME=Imobly
NEXT_PUBLIC_APP_VERSION=1.0.0
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# ====================
# PRODUCTION 
# ====================
# NEXT_PUBLIC_AUTH_API_URL=https://YOUR_AUTH_BACKEND.onrender.com/api/v1/auth
# NEXT_PUBLIC_API_URL=https://YOUR_BACKEND_NAME.onrender.com/api/v1
# NEXT_PUBLIC_APP_URL=https://YOUR_FRONTEND_NAME.onrender.com


