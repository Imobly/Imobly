# ============================================
# Imobly Frontend - Environment Variables
# ============================================

# ====================
# DEVELOPMENT (Local)
# ====================
# Copie para .env.local e use a API local
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase público — necessário: auth e storage passam por aqui.
# Não existe um serviço de Auth API separado; a autenticação é validada pelo
# próprio backend (FastAPI) usando o JWT emitido pelo Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Informações
NEXT_PUBLIC_APP_NAME=Imobly
NEXT_PUBLIC_APP_VERSION=1.0.0
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# ====================
# PRODUCTION
# ====================
# NEXT_PUBLIC_API_URL=https://YOUR_BACKEND_NAME.onrender.com/api/v1
# NEXT_PUBLIC_APP_URL=https://YOUR_FRONTEND_NAME.onrender.com


